<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.messagerie.controller.RegisterController"
      spacing="15"
      alignment="CENTER"
      style="-fx-padding: 35; -fx-background-color: #f0f4f8;">

    <!-- Titre -->
    <Text text="Messagerie Instantanée"
          style="-fx-font-size: 20; -fx-font-weight: bold; -fx-fill: #1e40af;"/>
    <Text text="Créer un compte"
          style="-fx-font-size: 14; -fx-fill: #64748b;"/>

    <!-- Formulaire -->
    <VBox spacing="8" maxWidth="280">
        <Label text="Nom d'utilisateur :"/>
        <TextField fx:id="champUsername" promptText="Choisissez un username"/>

        <Label text="Mot de passe :"/>
        <PasswordField fx:id="champPassword" promptText="Choisissez un mot de passe"/>

        <Label text="Confirmer le mot de passe :"/>
        <PasswordField fx:id="champConfirmPassword" promptText="Répétez le mot de passe"/>
    </VBox>

    <!-- Message d'information ou d'erreur -->
    <Label fx:id="labelMessage" style="-fx-text-fill: red; -fx-font-size: 13; -fx-font-weight: bold;"
           wrapText="true" maxWidth="340" alignment="CENTER" textAlignment="CENTER"/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="S'inscrire" onAction="#sInscrire" styleClass="btn-primary"/>
        <Button text="Retour à la connexion" onAction="#retourConnexion" styleClass="btn-secondary"/>
    </HBox>

</VBox>
