<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.messagerie.controller.ChatController"
            prefWidth="860" prefHeight="580"
            style="-fx-background-color: #1b4332;">

    <!-- ═══════════════════════════════════════════════════════
         PANNEAU GAUCHE : contacts
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="230"
              style="-fx-background-color: #f0f7eb;
                     -fx-border-color: #a8d5a2;
                     -fx-border-width: 0 2 0 0;">

            <!-- En-tête forêt profonde -->
            <HBox style="-fx-background-color: #1b4332;
                         -fx-padding: 16 14;
                         -fx-alignment: center-left;
                         -fx-spacing: 8;">
                <Label text="🌿"
                       style="-fx-font-size: 18;"/>
                <VBox spacing="1">
                    <Label text="Messagerie"
                           style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #d8f3dc;"/>
                    <Label text="Nature Chat"
                           style="-fx-font-size: 10; -fx-text-fill: #74c69d;"/>
                </VBox>
            </HBox>

            <!-- Sous-titre contacts -->
            <HBox style="-fx-padding: 10 14 4 14; -fx-alignment: center-left; -fx-spacing: 5;">
                <Label text="🌱"  style="-fx-font-size: 11;"/>
                <Label text="Contacts en ligne"
                       style="-fx-font-size: 11;
                              -fx-text-fill: #2d6a4f;
                              -fx-font-weight: bold;"/>
            </HBox>

            <!-- Séparateur -->
            <Separator style="-fx-background-color: #c8e6c0; -fx-padding: 0 10;"/>

            <!-- Liste des utilisateurs -->
            <ListView fx:id="listeUtilisateurs"
                      onMouseClicked="#selectionnerUtilisateur"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent;
                             -fx-border-color: transparent;
                             -fx-font-size: 13;"/>

            <!-- Bouton Rafraîchir -->
            <Button text="⟳   Rafraîchir"
                    onAction="#rafraichirUtilisateurs"
                    maxWidth="Infinity"
                    style="-fx-background-color: #40916c;
                           -fx-text-fill: #d8f3dc;
                           -fx-cursor: hand;
                           -fx-padding: 10;
                           -fx-font-size: 12;
                           -fx-font-weight: bold;
                           -fx-border-color: transparent;
                           -fx-background-radius: 0;"/>

            <!-- Bouton Déconnexion -->
            <Button text="⏻   Se déconnecter"
                    onAction="#seDeconnecter"
                    maxWidth="Infinity"
                    style="-fx-background-color: #6b2737;
                           -fx-text-fill: #fde8ec;
                           -fx-cursor: hand;
                           -fx-padding: 10;
                           -fx-font-size: 12;
                           -fx-font-weight: bold;
                           -fx-border-color: transparent;
                           -fx-background-radius: 0;"/>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         ZONE CENTRALE : conversation
         ═══════════════════════════════════════════════════════ -->
    <center>
        <VBox style="-fx-background-color: #e9f5e1;">

            <!-- En-tête de la conversation -->
            <HBox style="-fx-background-color: #2d6a4f;
                         -fx-padding: 12 18;
                         -fx-alignment: center-left;
                         -fx-spacing: 10;"
                  minHeight="54">
                <Label text="🍃"
                       style="-fx-font-size: 20;"/>
                <VBox spacing="1">
                    <Label fx:id="labelInterlocuteur"
                           text="Sélectionnez un contact"
                           style="-fx-font-size: 14;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #d8f3dc;"/>
                    <Label text="En ligne"
                           style="-fx-font-size: 10;
                                  -fx-text-fill: #95d5b2;"/>
                </VBox>
            </HBox>

            <!-- Bandeau décoratif sous l'en-tête -->
            <HBox style="-fx-background-color: #40916c; -fx-min-height: 3;"/>

            <!-- Zone des messages avec défilement -->
            <ScrollPane fx:id="scrollPane"
                        VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;
                               -fx-border-color: transparent;">
                <VBox fx:id="zoneMessages"
                      spacing="4"
                      style="-fx-padding: 14 8;"/>
            </ScrollPane>

            <!-- Zone de saisie -->
            <HBox spacing="10"
                  style="-fx-padding: 10 14;
                         -fx-background-color: #c8e6c0;
                         -fx-alignment: center-left;
                         -fx-border-color: #a8d5a2;
                         -fx-border-width: 1 0 0 0;">
                <TextField fx:id="champSaisie"
                           promptText="Écrire un message…"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 22;
                                  -fx-padding: 10 16;
                                  -fx-font-size: 13;
                                  -fx-background-color: #f0f7eb;
                                  -fx-border-color: #74c69d;
                                  -fx-border-radius: 22;
                                  -fx-border-width: 1.5;
                                  -fx-text-fill: #1b4332;
                                  -fx-prompt-text-fill: #74c69d;"/>
                <Button text="➤"
                        onAction="#envoyerMessage"
                        style="-fx-background-color: #1b4332;
                               -fx-text-fill: #d8f3dc;
                               -fx-background-radius: 50;
                               -fx-min-width: 44;
                               -fx-min-height: 44;
                               -fx-font-size: 17;
                               -fx-cursor: hand;
                               -fx-border-color: transparent;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
