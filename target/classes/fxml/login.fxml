<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.messagerie.controller.LoginController"
      spacing="15"
      alignment="CENTER"
      style="-fx-padding: 35; -fx-background-color: #f0f4f8;">

    <!-- Titre -->
    <Text text="Messagerie Instantanée"
          style="-fx-font-size: 20; -fx-font-weight: bold; -fx-fill: #1e40af;"/>
    <Text text="Connexion"
          style="-fx-font-size: 14; -fx-fill: #64748b;"/>

    <!-- Formulaire -->
    <VBox spacing="8" maxWidth="280">
        <Label text="Nom d'utilisateur :"/>
        <TextField fx:id="champUsername" promptText="Entrez votre username"/>

        <Label text="Mot de passe :"/>
        <PasswordField fx:id="champPassword" promptText="Entrez votre mot de passe"/>
    </VBox>

    <!-- Message d'erreur -->
    <Label fx:id="labelErreur" style="-fx-text-fill: red; -fx-font-size: 12;"/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Se connecter" onAction="#seConnecter" styleClass="btn-primary"/>
        <Button text="S'inscrire" onAction="#allerInscription" styleClass="btn-secondary"/>
    </HBox>

</VBox>
